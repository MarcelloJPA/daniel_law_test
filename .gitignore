# === Build output ===
# pasta padrão do Maven
/target/
/build/
/out/

# === Compiled class files ===
*.class

# === Pacotes gerados ===
# normalmente não se comita JARs/WARs pois eles são construídos pelo CI/Maven/Gradle
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# === Logs ===
*.log
spring.log

# === Diretórios e arquivos de IDEs/editors ===
# IntelliJ IDEA
*.iml
.idea/
/out/

# Eclipse
*.classpath
*.project
*.settings/

# VS Code
.vscode/

# outros
*.iws

# === Maven wrapper ===
/.mvn/wrapper/maven-wrapper.jar

# === Java crash logs ===
hs_err_pid*
replay_pid*

# === Arquivos temporários e backups ===
*~
*.swp
*.bak
*.tmp

# === Arquivos de sistema operacional ===
.DS_Store
Thumbs.db
.metadata/
